// RSI(2) dip sinyali — Midas 1-3 gün çalışması (2026-11-07). Pine Script v5. Derlenmedi.
// "Ön ayar otomatik" açıkken:
//   SVXY (B9): RSI(2) < 10 ve kapanış > SMA(200) -> C0 al, 2 gün tut (SMA çıkışı yok). ⚠ PTP: Midas'ta %10 kesinti yoksa; yoksa aynı sinyalle QQQ.
//   NVDA, AMZN, MSFT, GOOGL, TSLA, AAPL, META (B10): aynı koşul HİSSENİN grafiğinde; işlem 2x ETF'te (NVDL, AMZU, MSFU, GGLL, TSLL, AAPU, METU)
//      ya da hissenin kendisinde; çıkış: girişten sonra hisse kapanışı > SMA(5) olan ilk gün, en geç 3. gün.
// Alarm: "Bar kapanışında bir kez" (kışın TR 00:00). "RSI2 giriş" -> C0: şimdi after-hours limitle al. "RSI2 çıkış" -> çıkış koşulu
// bu kapanışta oluştu: kapanış öncesi canlı fiyatla kontrol etmediysen ilk fırsatta (after-hours limit) sat. "En geç yarın sat" -> süre doluyor.
// Çakışma kuralı backtest motoruyla aynı (pozisyondayken gelen sinyal yok sayılır).
//@version=5
indicator("RSI(2) dip (Midas 1-3 gün)", overlay=true)
otomatik = input.bool(true, "Ön ayarı sembole göre otomatik seç")
esik     = input.float(10, "RSI(2) eşiği")
trendLen = input.int(200, "Trend SMA uzunluğu", minval=10)
smaCikG  = input.int(5, "Çıkış SMA uzunluğu (0 = yalnız süre) (elle)", minval=0)
maxGunG  = input.int(3, "En çok tutuş, gün (elle)", minval=1, maxval=5)

t = syminfo.ticker
isSVXY = t == "SVXY"
isMega = t == "NVDA" or t == "AMZN" or t == "MSFT" or t == "GOOGL" or t == "TSLA" or t == "AAPL" or t == "META"
smaCik = otomatik and isSVXY ? 0 : otomatik and isMega ? 5 : smaCikG
maxGun = otomatik and isSVXY ? 2 : otomatik and isMega ? 3 : maxGunG

r = ta.rsi(close, 2)
trendSma = ta.sma(close, trendLen)
cikSma = ta.sma(close, math.max(smaCikG, 1))      // global kapsamda hesaplanır
cikSma5 = ta.sma(close, 5)
cikSeri = smaCik == 5 ? cikSma5 : cikSma
sig = r < esik and close > trendSma

var int entryBar = na
var int exitBar = na
cikis = false
if not na(entryBar)
    gun = bar_index - entryBar
    smaCikis = smaCik > 0 and gun >= 1 and close > cikSeri
    if gun >= maxGun or smaCikis
        cikis := true
        exitBar := bar_index
        entryBar := na
kabul = sig and na(entryBar) and (na(exitBar) or bar_index >= exitBar)
if kabul
    entryBar := bar_index

plotshape(kabul, "Giriş (C0: bu kapanışta)", shape.triangleup, location.belowbar, color.new(color.teal, 0), size=size.small)
plotshape(cikis, "Çıkış", shape.square, location.abovebar, color.new(color.orange, 0), size=size.tiny)
plot(trendSma, "Trend SMA", color.new(color.gray, 30))
enGecYarin = not na(entryBar) and bar_index - entryBar + 1 >= maxGun
alertcondition(kabul, "RSI2 giriş", "{{ticker}}: RSI(2) dip sinyali (kural: RAPOR.md B9/B10)")
alertcondition(enGecYarin, "En geç yarın sat", "{{ticker}}: süre doluyor — en geç yarın kapanışa yakın sat")
alertcondition(cikis, "RSI2 çıkış", "{{ticker}}: RSI(2) kuralının çıkış günü")
